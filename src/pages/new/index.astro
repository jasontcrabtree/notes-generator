---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="New note | Notes" description="Create a new distilled learning note.">
  <main class="admin-shell">
    <h1 class="page-title">New note</h1>
    <p class="lede">
      Paste a ChatGPT shared link, copied conversation text, or both. Distill it,
      edit the note, then publish to GitHub.
    </p>

    <section id="login-panel" class="panel" hidden>
      <label>
        Admin password
        <input id="password" type="password" autocomplete="current-password" />
      </label>
      <button id="login-button" type="button">Unlock</button>
      <p id="login-status" class="status"></p>
    </section>

    <section id="admin-panel" class="admin-grid" hidden>
      <form class="panel" id="source-form">
        <label>
          ChatGPT shared link
          <input id="share-url" type="url" placeholder="https://chatgpt.com/share/..." />
        </label>
        <label>
          Source
          <select id="source">
            <option value="chatgpt">ChatGPT</option>
            <option value="codex">Codex</option>
            <option value="manual">Manual</option>
          </select>
        </label>
        <label>
          Question
          <textarea id="question" placeholder="Paste the copied ChatGPT text or the question you asked."></textarea>
        </label>
        <label>
          Extra context
          <textarea id="answer" placeholder="Optional: add constraints, corrections, links, or notes."></textarea>
        </label>
        <div class="button-row">
          <button id="draft-button" type="submit">Distill draft</button>
          <button class="secondary" id="clear-button" type="button">Clear</button>
        </div>
        <p id="draft-status" class="status"></p>
      </form>

      <form class="panel" id="publish-form">
        <label>
          Title
          <input id="title" required />
        </label>
        <label>
          Slug
          <input id="slug" required />
        </label>
        <label>
          Description
          <textarea id="description" required></textarea>
        </label>
        <label>
          Tags
          <input id="tags" placeholder="swift, swiftdata, swiftui" />
        </label>
        <label>
          Definitive source title
          <input id="source-title" required />
        </label>
        <label>
          Definitive source URL
          <input id="source-url" type="url" required />
        </label>
        <label>
          MDX body
          <textarea id="body" required></textarea>
        </label>
        <button id="publish-button" type="submit">Publish</button>
        <p id="publish-status" class="status"></p>
      </form>
    </section>
  </main>
</BaseLayout>

<script>
  // @ts-nocheck
  const $ = (id) => document.getElementById(id);

  const loginPanel = $("login-panel");
  const adminPanel = $("admin-panel");
  const loginStatus = $("login-status");
  const draftStatus = $("draft-status");
  const publishStatus = $("publish-status");

  function setDraft(draft) {
    $("title").value = draft.title || "";
    $("slug").value = draft.slug || "";
    $("description").value = draft.description || "";
    $("tags").value = (draft.tags || []).join(", ");
    $("source-title").value = draft.sourceTitle || "";
    $("source-url").value = draft.sourceUrl || "";
    $("body").value = draft.body || "";
  }

  async function request(path, payload) {
    const response = await fetch(path, {
      method: "POST",
      headers: { "content-type": "application/json" },
      body: JSON.stringify(payload),
    });
    const data = await response.json();
    if (!response.ok) {
      throw new Error(data.error || "Request failed");
    }
    return data;
  }

  async function refreshSession() {
    const response = await fetch("/api/session");
    const session = await response.json();

    if (!session.configured) {
      loginPanel.hidden = false;
      loginStatus.textContent = "Set ADMIN_PASSWORD in Vercel before using this page.";
      loginStatus.className = "status error";
      return;
    }

    loginPanel.hidden = session.authenticated;
    adminPanel.hidden = !session.authenticated;
  }

  $("login-button").addEventListener("click", async () => {
    loginStatus.textContent = "Checking...";
    loginStatus.className = "status";
    try {
      await request("/api/login", { password: $("password").value });
      await refreshSession();
    } catch (error) {
      loginStatus.textContent = error.message;
      loginStatus.className = "status error";
    }
  });

  $("source-form").addEventListener("submit", async (event) => {
    event.preventDefault();
    $("draft-button").disabled = true;
    draftStatus.textContent = "Distilling...";
    draftStatus.className = "status";

    try {
      const data = await request("/api/draft", {
        source: $("source").value,
        shareUrl: $("share-url").value,
        question: $("question").value,
        answer: $("answer").value,
      });
      setDraft(data.draft);
      draftStatus.textContent = "Draft ready. Give it a quick editorial pass.";
    } catch (error) {
      draftStatus.textContent = error.message;
      draftStatus.className = "status error";
    } finally {
      $("draft-button").disabled = false;
    }
  });

  $("publish-form").addEventListener("submit", async (event) => {
    event.preventDefault();
    $("publish-button").disabled = true;
    publishStatus.textContent = "Publishing to GitHub...";
    publishStatus.className = "status";

    try {
      const tags = $("tags").value
        .split(",")
        .map((tag) => tag.trim())
        .filter(Boolean);

      const data = await request("/api/publish", {
        draft: {
          title: $("title").value,
          slug: $("slug").value,
          description: $("description").value,
          tags,
          source: $("source").value,
          sourceTitle: $("source-title").value,
          sourceUrl: $("source-url").value,
          body: $("body").value,
        },
      });

      const url = data.result.commitUrl || data.result.htmlUrl;
      publishStatus.innerHTML = url
        ? `Published. <a href="${url}">View GitHub commit</a>.`
        : "Published.";
    } catch (error) {
      publishStatus.textContent = error.message;
      publishStatus.className = "status error";
    } finally {
      $("publish-button").disabled = false;
    }
  });

  $("clear-button").addEventListener("click", () => {
    $("share-url").value = "";
    $("question").value = "";
    $("answer").value = "";
    setDraft({ title: "", slug: "", description: "", tags: [], sourceTitle: "", sourceUrl: "", body: "" });
  });

  refreshSession();
</script>
