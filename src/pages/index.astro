---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const selectedTag = Astro.url.searchParams.get("tag");
const allNotes = (await getCollection("notes"))
  .filter((note) => !note.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const notes = selectedTag
  ? allNotes.filter((note) => note.data.tags.includes(selectedTag))
  : allNotes;
---

<BaseLayout>
  <main>
    <header class="catalogue-head">
      {selectedTag && <p class="catalogue-kicker">Tag: {selectedTag}</p>}
      <h1 class="page-title">Notes</h1>
    </header>

    <section class="note-list" aria-label="Notes">
      {
        notes.map((note) => (
          <article class="note-card">
            <p class="meta">
              {note.data.pubDate.toLocaleDateString("en-GB", {
                day: "numeric",
                month: "short",
                year: "numeric",
              })}
            </p>
            <h2>
              <a href={`/notes/${note.id}/`}>{note.data.title}</a>
            </h2>
            <p>{note.data.description}</p>
            <div class="tags">
              {note.data.tags.map((tag) => (
                <a class="tag" href={`/?tag=${encodeURIComponent(tag)}`}>{tag}</a>
              ))}
            </div>
          </article>
        ))
      }
    </section>
  </main>
</BaseLayout>
